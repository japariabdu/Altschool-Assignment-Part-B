function diffObjects(oldObj, newObj) {
  const result = {
    added: {},
    removed: {},
    changed: {}
  };

  // Collect all unique top-level keys across both objects
  const allKeys = new Set([...Object.keys(oldObj), ...Object.keys(newObj)]);

  for (const key of allKeys) {
    const hasInOld = Object.prototype.hasOwnProperty.call(oldObj, key);
    const hasInNew = Object.prototype.hasOwnProperty.call(newObj, key);

    if (!hasInOld && hasInNew) {
      // Key exists only in newObj
      result.added[key] = newObj[key];
    } else if (hasInOld && !hasInNew) {
      // Key exists only in oldObj
      result.removed[key] = oldObj[key];
    } else if (oldObj[key] !== newObj[key]) {
      // Key exists in both, but value changed
      result.changed[key] = {
        from: oldObj[key],
        to: newObj[key]
      };
    }
  }

  return result;
}

// Test case
console.log(diffObjects(
  { name: 'Setemi', role: 'Engineer', country: 'Jamaica' },
  { name: 'Setemi', role: 'Senior Engineer', city: 'Kingston' }
));
// Output:
// {
//   added: { city: 'Kingston' },
//   removed: { country: 'Jamaica' },
//   changed: { role: { from: 'Engineer', to: 'Senior Engineer' } }
// }
